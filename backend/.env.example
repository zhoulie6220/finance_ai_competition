# 复制为 .env 后填写。.env 不入库（见 .gitignore）。

# ---- 模型接口（DeepSeek，OpenAI 兼容）----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在此填入你的密钥
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_SEED=42

# 离线回放：置 1 时不发起任何真实请求，改用 backend/app/data/cassettes/ 下的
# 预录响应。现场演示断网时使用，界面会显著标注「离线回放模式」。
OFFLINE_MODE=0

# ---- 数据根目录（白名单）----
# 后端只允许读写此目录下的文件，所有访问写入 file_access_log 表。
# 相对路径以 backend/ 为基准。
DATA_ROOT=./var

# ---- 服务 ----
HOST=127.0.0.1
PORT=8000
# 前端开发服务器地址，用于 CORS
CORS_ORIGIN=http://localhost:5173

# ---- 日志 ----
LOG_LEVEL=INFO
