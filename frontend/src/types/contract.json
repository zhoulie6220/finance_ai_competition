        },
        "value_raw": {
          "description": "原样文本，如 '12,345,678,901.23'",
          "title": "Value Raw",
          "type": "string"
        },
        "raw_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Unit"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "source_file_id": {
          "title": "Source File Id",
          "type": "string"
        },
        "source_page": {
          "title": "Source Page",
          "type": "integer"
        },
        "source_table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
