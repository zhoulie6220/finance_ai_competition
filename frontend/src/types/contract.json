          "title": "Source Row Label"
        },
        "bbox": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "extractor": {
          "description": "'rule:v3' / 'llm:deepseek-chat@<prompt_hash>' / 'human:<uid>'",
          "title": "Extractor",
          "type": "string"
        },
        "restated": {
          "default": false,
          "title": "Restated",
          "type": "boolean"
        },
        "restatement_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Restatement Note"
        },
        "comparable": {
          "default": true,
          "title": "Comparable",
          "type": "boolean"
        },
        "incomparable_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/IncomparableReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "project_id",
        "company_id",
        "is_primary",
        "metric",
        "period",
        "scope",
        "source_file",
        "source_page",
        "source_text",
        "confidence",
        "status",
        "period_kind",
        "source_file_id",
        "extractor",
        "created_at"
      ],
      "title": "FinancialFact",
      "type": "object"
    },
    "ObservationResolution": {
      "description": "同一次取值的多个观测，裁决结果。",
      "enum": [
        "pending",
        "adopted",
        "rejected"
      ],
      "title": "ObservationResolution",
      "type": "string"
    },
    "SourceLocation": {
      "description": "同一数字在年报中的位置。位置不同可信度不同，交叉校验时按此加权。",
      "enum": [
        "main_statement",
        "indicator_table",
        "notes",
        "mdna_text",
        "other"
      ],
      "title": "SourceLocation",
      "type": "string"
    },
    "FactObservation": {
      "description": "同一笔事实在年报里的一次出现。\n\n同一个数字往往同时出现在主要指标表、三张主表、附注和正文里，精度还可能不同。\n每次出现各记一条观测，交叉校验后把被采纳的那条标为 adopted 并回填 fact_id，\n其余必须写明未采纳理由。",
