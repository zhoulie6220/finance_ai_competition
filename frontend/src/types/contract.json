        },
        "source_text": {
          "title": "Source Text",
          "type": "string"
        },
        "bbox": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "extractor": {
          "title": "Extractor",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "resolution": {
