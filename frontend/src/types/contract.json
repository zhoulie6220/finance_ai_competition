{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "投研工作台数据契约",
  "description": "由 backend/app/schemas/ 生成",
  "$defs": {
    "FactStatus": {
      "enum": [
        "validated",
        "needs_review",
        "not_found",
        "rejected"
      ],
      "title": "FactStatus",
      "type": "string"
    },
    "IncomparableReason": {
      "description": "不可直接比较的原因。标记后不进指数扣分，但从主中枢中排除。",
      "enum": [
        "mna",
        "restructuring",
        "asset_injection",
        "scope_change",
        "restatement",
        "policy_change",
        "industry_cycle",
        "other"
      ],
      "title": "IncomparableReason",
      "type": "string"
    },
    "PeriodKind": {
      "description": "数值本身的性质，不是它出现在哪份报告里。\n\n刻意不含 'prior'：FY2023 的数字无论在 2023 年报的「本期」栏还是 2024 年报的\n「上期」栏，都是同一笔事实，period='2023' + kind='current'。多一个 kind 会让\n同一笔事实存成两行，聚合时重复计算。",
      "enum": [
        "current",
        "instant",
        "opening",
        "average"
      ],
      "title": "PeriodKind",
      "type": "string"
    },
    "Scope": {
      "description": "会计口径。默认合并口径；母公司口径只在用户明确选择时展示。",
      "enum": [
        "consolidated",
        "parent"
      ],
      "title": "Scope",
      "type": "string"
    },
    "FinancialFact": {
      "description": "一条已验证或待复核的财务事实。\n\n十个契约字段：metric / value / unit / period / scope / source_file /\nsource_page / source_text / confidence / status。",
      "properties": {
        "fact_id": {
          "title": "Fact Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "company_id": {
          "title": "Company Id",
          "type": "string"
        },
        "is_primary": {
          "title": "Is Primary",
          "type": "boolean"
        },
        "metric": {
          "description": "契约名；数据库列是 metric_key",
          "title": "Metric",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "契约名；数据库列是 value_millions。单位统一为百万元。缺失时为 None，**绝不为 0**",
          "title": "Value"
        },
        "unit": {
          "default": "百万元",
          "title": "Unit",
          "type": "string"
        },
        "period": {
          "description": "'2024' / '2024H1' / '2024-12-31'",
          "title": "Period",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        },
        "source_page": {
